{
	"name": "opencode-sessions-streamdeck",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Stream Deck plugin that shows OpenCode agent sessions and their status.",
	"license": "MIT",
	"scripts": {
		"icons": "node scripts/generate-icons.mjs",
		"build": "npm run icons && rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart ai.opencode.streamdeck\"",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate ai.opencode.streamdeck.sdPlugin",
		"pack": "npm run build && streamdeck pack ai.opencode.streamdeck.sdPlugin --output dist --force"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.2",
		"@opencode/client": "^2.0.29"
	},
	"devDependencies": {
		"@elgato/cli": "^1.7.1",
		"@rollup/plugin-commonjs": "^28.0.2",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.2",
		"@tsconfig/node20": "^20.1.4",
		"@types/node": "^22.13.0",
		"rollup": "^4.32.1",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3"
	}
}
